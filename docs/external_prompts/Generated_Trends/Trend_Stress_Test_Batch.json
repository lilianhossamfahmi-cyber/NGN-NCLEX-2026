            "rationale": {
                "coreConcept": "DKA Management / Hypokalemia",
                "caseSummary": "Glucose and Gap are improving, BUT Potassium has crashed to 3.3.",
                "answerAnalysis": "Insulin drives Potassium into cells. Even though the DKA is resolving, the priority shifts to preventing arrhythmia from Hypokalemia. Insulin must be held or K+ replaced immediately.",
                "trap": "Focusing only on the improving glucose.",
                "difficulty": {
                    "level": 4,
                    "label": "Proficient",
                    "subtext": "Requires prioritizing conflicting trends (Good Glucose vs Bad Potassium).",
                    "clinicalStrategy": "Fix the K+ before the Glucose. No K+, No Insulin.",
                    "recommendedActions": [
                        "Hold Insulin",
                        "Hang KCL IVPB"
                    ]
                }
            },
            "structure": {
                "type": "trend",
                "questionFormat": "multiple-choice",
                "options": [
                    {
                        "id": "o1",
                        "text": "Pause insulin and administer potassium",
                        "isCorrect": true,
                        "rationale": "K+ of 3.3 is critical; insulin will lower it further."
                    },
                    {
                        "id": "o2",
                        "text": "Increase insulin titration",
                        "isCorrect": false,
                        "rationale": "Would cause fatal arrhythmia."
                    },
                    {
                        "id": "o3",
                        "text": "Stop IV fluids",
                        "isCorrect": false,
                        "rationale": "Patient is still dehydrated."
                    },
                    {
                        "id": "o4",
                        "text": "Administer Bicarbonate",
                        "isCorrect": false,
                        "rationale": "Gap is closing, bicarb not indicated."
                    }
                ]
            }
