            "rows": [
                {
                    "id": "r1",
                    "text": "Heart Rate 52 bpm"
                },
                {
                    "id": "r2",
                    "text": "Heart Rate 88 bpm"
                },
                {
                    "id": "r3",
                    "text": "Heart Rate 115 bpm"
                },
                {
                    "id": "r4",
                    "text": "Heart Rate 40 bpm"
                }
            ],
            "answers": {
                "r1": "c1",
                "r2": "c2",
                "r3": "c3",
                "r4": "c1"
            },
            "rationales": {
                "general": "A heart rate less than 60 bpm is classified as Bradycardia. A rate between 60-100 bpm is Normal. A rate greater than 100 bpm is Tachycardia."
