        "metadata": {
            "title": "Cardiogenic Shock Cues",
            "authorId": "system-ai",
            "status": "published",
            "sourceOrigin": "batch-gen",
            "sourceReferences": [],
            "hasStudentPreview": true,
            "createdAt": "2026-01-13T12:20:00Z",
            "updatedAt": "2026-01-13T12:20:00Z"
        },
        "pedagogy": {
            "difficultyLevel": 5,
            "clinicalFocus": "Cardiology",
            "cjmmPhase": "Recognize Cues",
            "bloom": "Synthesis"
        },
        "content": {
            "text": "Assessment Note 1400: Client is id='h1'confused/id and lethargic. Extremities are id='h2'cool and mottled/id. HR 125 (Sinus Tach). BP id='h3'82/50/id mmHg. Urine output for last 2 hours is id='h4'15 mL total/id.",
            "tokens": [
                {
                    "id": "h1",
                    "text": "confused",
                    "correct": true
                },
                {
                    "id": "h2",
                    "text": "cool and mottled",
                    "correct": true
                },
                {
                    "id": "h3",
                    "text": "82/50",
                    "correct": true
                },
                {
                    "id": "h4",
                    "text": "15 mL total",
                    "correct": true
                }
            ],
            "prompt": "Highlight the findings that indicate organ hypoperfusion consistent with Cardiogenic Shock.",
            "rationales": {
                "general": "Signs of shock (hypoperfusion) include Altered Mental Status (confused), Poor peripheral perfusion (cool/mottled), Hypotension (82/50), and Oliguria (15mL/2hr). Tachycardia is a compensatory mechanism."
            }
        }
    }
