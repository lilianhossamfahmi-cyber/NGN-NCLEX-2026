        "content": {
            "prompt": "For each heart rate value below, identify the correct clinical terminology.",
            "columns": [
                {
                    "id": "c1",
                    "label": "Bradycardia"
                },
                {
                    "id": "c2",
                    "label": "Normal Rate"
