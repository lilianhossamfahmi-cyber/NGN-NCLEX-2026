{
    "name": "master-ngn-generator",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "bulk:gen": "node -r dotenv/config --loader ts-node/esm --experimental-specifier-resolution=node scripts/bulkGenerator.ts",
        "bulk:repair": "npx tsx --env-file=.env scripts/bulkRepair.ts",
        "dev": "vite",
        "build": "npx tsx scripts/generateSchema.ts && node node_modules/typescript/bin/tsc && vite build",
        "preview": "vite preview",
        "type-check": "node node_modules/typescript/bin/tsc --noEmit",
        "lint": "eslint src --ext .ts,.tsx",
        "test": "jest",
        "test:replay": "jest --testPathPatterns replay-payloads",
        "schema:gen": "npx tsx scripts/generateSchema.ts",
        "schema:diff": "npx tsx scripts/schemaDiff.ts",
        "backfill": "npx tsx scripts/backfillItems.ts",
        "test:integration": "jest --testPathPattern=integration",
        "test:smoke": "jest --testPathPattern=smoke",
        "deploy:staging": "vercel deploy --prod=false",
        "deploy:production": "vercel deploy --prod",
        "logs:production": "vercel logs production"
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-collapsible": "^1.1.12",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-toast": "^1.2.15",
        "@supabase/supabase-js": "^2.90.1",
        "@types/dompurify": "^3.0.5",
        "@types/uuid": "^10.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cross-fetch": "^4.1.0",
        "dompurify": "^3.3.1",
        "dotenv": "^17.2.3",
        "html2canvas": "^1.4.1",
        "isomorphic-dompurify": "^2.35.0",
        "jspdf": "^3.0.4",
        "lucide-react": "^0.562.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-draggable": "^4.5.0",
        "recharts": "^3.6.0",
        "tailwind-merge": "^3.4.0",
        "tsx": "^4.21.0",
        "uuid": "^13.0.0",
        "zod": "^4.3.5",
        "ajv": "^8.17.1",
        "ajv-formats": "^3.0.1",
        "zod-to-json-schema": "^3.23.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.18",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.1",
        "@types/dotenv": "^6.1.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^25.0.6",
        "@types/react": "^18.2.66",
        "@types/react-dom": "^18.2.22",
        "@vercel/node": "^5.5.22",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.23",
        "is-extglob": "^2.1.1",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.2.0",
        "msw": "^2.12.4",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.18",
        "terser": "^5.44.1",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vite": "^5.2.0"
    }
}